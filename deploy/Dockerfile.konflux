# Konflux/hermetic build: Cachi2 prefetches the npm and Go dependencies and
# makes its build environment available at /cachi2/cachi2.env.
#
# Keep these image references aligned with the versions in package.json and
# go.mod. Konflux/MintMaker should replace tags with approved digest-pinned
# references when the component is onboarded.
ARG NODE_IMAGE=registry.access.redhat.com/ubi9/nodejs-22:1-1790265744@sha256:510a73eeff392500e22eadf976686dbd16c27eaa1a8808f8f51b29fec950f68c
ARG GO_IMAGE=registry.access.redhat.com/ubi9/go-toolset:1.25
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi-micro:9.8@sha256:7a0454cbd9bd847e8f6a63b6f0254a6efbeb6e0ed71a5d824a4f6cccbe626650

# --- Frontend build ---
FROM ${NODE_IMAGE} AS frontend

WORKDIR /opt/app-root/src
COPY --chown=1001:0 frontend/package.json frontend/package-lock.json ./
RUN . /cachi2/cachi2.env && \
    npm ci --offline --no-audit --no-fund

COPY --chown=1001:0 frontend/ ./
RUN npm run build

# --- Backend build ---
FROM ${GO_IMAGE} AS backend

WORKDIR /opt/app-root/src
COPY --chown=1001:0 backend/go.mod backend/go.sum ./
RUN . /cachi2/cachi2.env && go mod download

COPY --chown=1001:0 backend/ ./
RUN . /cachi2/cachi2.env && \
    CGO_ENABLED=0 go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /opt/app-root/src/openshell-dashboard \
      ./cmd/server

# --- Runtime ---
FROM ${RUNTIME_IMAGE}

LABEL io.opendatahub.component="openshell-dashboard" \
      io.k8s.display-name="OpenShell Dashboard" \
      name="open-data-hub/openshell-dashboard" \
      summary="OpenShell Dashboard" \
      description="Dashboard for the OpenShell gateway"

COPY --from=backend --chown=1001:0 \
    /opt/app-root/src/openshell-dashboard \
    /usr/local/bin/openshell-dashboard
COPY --from=frontend --chown=1001:0 \
    /opt/app-root/src/dist \
    /srv/static

ENV PORT=8080 \
    STATIC_DIR=/srv/static

USER 1001:0
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/openshell-dashboard"]
